# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dental_clinic

# JWT Configuration
JWT_ACCESS_SECRET=dental-clinic-access-secret-key-32chars-min
JWT_REFRESH_SECRET=dental-clinic-refresh-secret-key-32chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cookie Configuration
COOKIE_SECRET=dental-clinic-cookie-secret
